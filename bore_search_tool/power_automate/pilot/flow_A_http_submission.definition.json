{
  "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "$connections": {
      "defaultValue": {},
      "type": "Object"
    },
    "$authentication": {
      "defaultValue": {},
      "type": "SecureObject"
    }
  },
  "triggers": {
    "manual": {
      "type": "Request",
      "kind": "Http",
      "inputs": {
        "method": "POST"
      },
      "runtimeConfiguration": {
        "concurrency": {
          "runs": 1
        }
      },
      "description": "Who can trigger the flow: Anyone. Leave the Request Body JSON Schema empty: the page posts JSON as text/plain (no browser preflight) and Parse_report reads it. Settings: Concurrency Control on, degree of parallelism 1, so two companies submitting at once never write the workbook together."
    }
  },
  "actions": {
    "Parse_report": {
      "runAfter": {},
      "type": "ParseJson",
      "inputs": {
        "content": "@json(string(triggerBody()))",
        "schema": {
          "type": "object",
          "properties": {
            "action": {
              "type": "string"
            },
            "holder": {
              "type": "string"
            },
            "accessCode": {
              "type": "string"
            },
            "period": {
              "type": "string"
            },
            "submitter": {
              "type": "object",
              "properties": {
                "email": {
                  "type": "string"
                },
                "name": {
                  "type": "string"
                }
              }
            },
            "report": {
              "type": [
                "object",
                "null"
              ]
            },
            "app": {
              "type": "object"
            }
          }
        }
      },
      "description": "string() makes this work whether the body arrived as text/plain (the page) or as application/json (a test tool)."
    },
    "Lookup_tenure_holder": {
      "type": "OpenApiConnection",
      "inputs": {
        "host": {
          "connectionName": "shared_excelonlinebusiness",
          "apiId": "/providers/Microsoft.PowerApps/apis/shared_excelonlinebusiness",
          "operationId": "GetItems"
        },
        "parameters": {
          "source": "me",
          "drive": "<pick the OneDrive or SharePoint library in the designer>",
          "file": "<pick MGA_master_register.xlsx>",
          "table": "TenureHolders",
          "$filter": "@{concat('Code eq ''', toUpper(string(coalesce(body('Parse_report')?['holder'], ''))), '''')}"
        }
      },
      "description": "Excel Online (Business): List rows present in a table. Table TenureHolders, Filter Query Code eq '<holder code>'. coalesce() keeps a missing holder from throwing.",
      "runAfter": {
        "Parse_report": [
          "Succeeded"
        ]
      }
    },
    "Holder_row": {
      "runAfter": {
        "Lookup_tenure_holder": [
          "Succeeded"
        ]
      },
      "type": "Compose",
      "inputs": "@if(greater(length(body('Lookup_tenure_holder')?['value']), 0), first(body('Lookup_tenure_holder')?['value']), json('{}'))",
      "description": "The matching TenureHolders row, or an empty object when the code is unknown (so the checks below compare against blanks instead of failing on null)."
    },
    "Check_access": {
      "runAfter": {
        "Holder_row": [
          "Succeeded"
        ]
      },
      "type": "If",
      "expression": {
        "and": [
          {
            "greater": [
              "@length(body('Lookup_tenure_holder')?['value'])",
              0
            ]
          },
          {
            "equals": [
              "@toLower(string(coalesce(outputs('Holder_row')?['Active'], '')))",
              "yes"
            ]
          },
          {
            "equals": [
              "@toUpper(string(coalesce(outputs('Holder_row')?['AccessCode'], '#none')))",
              "@toUpper(string(coalesce(body('Parse_report')?['accessCode'], '')))"
            ]
          },
          {
            "greater": [
              "@length(string(coalesce(outputs('Holder_row')?['EmailDomain'], '')))",
              1
            ]
          },
          {
            "equals": [
              "@and(equals(length(split(string(coalesce(body('Parse_report')?['submitter']?['email'], '')), '@')), 2), not(contains(string(coalesce(body('Parse_report')?['submitter']?['email'], '')), ';')), not(contains(string(coalesce(body('Parse_report')?['submitter']?['email'], '')), ',')), not(contains(string(coalesce(body('Parse_report')?['submitter']?['email'], '')), ' ')), less(length(string(coalesce(body('Parse_report')?['submitter']?['email'], ''))), 255))",
              true
            ]
          },
          {
            "equals": [
              "@equals(toLower(last(split(string(coalesce(body('Parse_report')?['submitter']?['email'], '')), '@'))), toLower(replace(string(coalesce(outputs('Holder_row')?['EmailDomain'], '#none')), '@', '')))",
              true
            ]
          }
        ]
      },
      "actions": {
        "Is_verify": {
          "type": "If",
          "expression": {
            "equals": [
              "@body('Parse_report')?['action']",
              "verify"
            ]
          },
          "actions": {
            "Respond_verified": {
              "type": "Response",
              "kind": "Http",
              "inputs": {
                "statusCode": 200,
                "headers": {
                  "Content-Type": "application/json"
                },
                "body": {
                  "ok": true,
                  "holder": "@outputs('Holder_row')?['Code']",
                  "holderName": "@outputs('Holder_row')?['HolderName']",
                  "period": "@body('Parse_report')?['period']"
                }
              }
            }
          },
          "else": {
            "actions": {
              "Client_ref": {
                "type": "Compose",
                "inputs": "@toUpper(replace(string(coalesce(body('Parse_report')?['report']?['clientRef'], '')), ' ', ''))",
                "description": "The page's reference for this version of the report. The same reference arriving twice (a retry after a timeout) must not create a second row."
              },
              "Find_existing": {
                "type": "OpenApiConnection",
                "inputs": {
                  "host": {
                    "connectionName": "shared_excelonlinebusiness",
                    "apiId": "/providers/Microsoft.PowerApps/apis/shared_excelonlinebusiness",
                    "operationId": "GetItems"
                  },
                  "parameters": {
                    "source": "me",
                    "drive": "<pick the OneDrive or SharePoint library in the designer>",
                    "file": "<pick MGA_master_register.xlsx>",
                    "table": "MGAData",
                    "$filter": "@{if(empty(outputs('Client_ref')), 'ClientRef eq ''NONE-NEVER-MATCHES''', concat('ClientRef eq ''', outputs('Client_ref'), ''''))}",
                    "$top": 1
                  }
                },
                "runAfter": {
                  "Client_ref": [
                    "Succeeded"
                  ]
                },
                "description": "Excel Online (Business): List rows present in a table. Table MGAData, Filter Query ClientRef eq '<client ref>', Top Count 1."
              },
              "Already_lodged": {
                "runAfter": {
                  "Find_existing": [
                    "Succeeded"
                  ]
                },
                "type": "If",
                "expression": {
                  "and": [
                    {
                      "greater": [
                        "@length(body('Find_existing')?['value'])",
                        0
                      ]
                    }
                  ]
                },
                "actions": {
                  "Respond_already": {
                    "type": "Response",
                    "kind": "Http",
                    "inputs": {
                      "statusCode": 200,
                      "headers": {
                        "Content-Type": "application/json"
                      },
                      "body": {
                        "ok": true,
                        "duplicate": true,
                        "submissionId": "@first(body('Find_existing')?['value'])?['Submission ID']",
                        "receivedAt": "@first(body('Find_existing')?['value'])?['Submitted at']",
                        "receiptTo": "@body('Parse_report')?['submitter']?['email']"
                      }
                    }
                  }
                },
                "else": {
                  "actions": {
                    "Submission_ID": {
                      "type": "Compose",
                      "inputs": "@concat('MGA-', formatDateTime(convertTimeZone(utcNow(), 'UTC', 'E. Australia Standard Time'), 'yyyyMMdd'), '-', toUpper(substring(replace(guid(), '-', ''), 0, 6)))"
                    },
                    "Received_at": {
                      "runAfter": {
                        "Submission_ID": [
                          "Succeeded"
                        ]
                      },
                      "type": "Compose",
                      "inputs": "@convertTimeZone(utcNow(), 'UTC', 'E. Australia Standard Time', 'yyyy-MM-dd HH:mm')"
                    },
                    "Add_row_to_register": {
                      "type": "OpenApiConnection",
                      "inputs": {
                        "host": {
                          "connectionName": "shared_excelonlinebusiness",
                          "apiId": "/providers/Microsoft.PowerApps/apis/shared_excelonlinebusiness",
                          "operationId": "AddRowV2"
                        },
                        "parameters": {
                          "source": "me",
                          "drive": "<pick the OneDrive or SharePoint library in the designer>",
                          "file": "<pick MGA_master_register.xlsx>",
                          "table": "MGAData",
                          "item/Tenure Holder": "@{outputs('Holder_row')?['HolderName']}",
                          "item/RN": "@body('Parse_report')?['report']?['templateRow']?['RN']",
                          "item/Bore assessment status": "@{body('Parse_report')?['report']?['templateRow']?['Bore assessment status']}",
                          "item/Bore assessment date": "@{body('Parse_report')?['report']?['templateRow']?['Bore assessment date']}",
                          "item/Submitted to OGIA date": "@{body('Parse_report')?['report']?['templateRow']?['Submitted to OGIA date']}",
                          "item/Bore assessment outcome": "@{body('Parse_report')?['report']?['templateRow']?['Bore assessment outcome']}",
                          "item/MGA status": "@{body('Parse_report')?['report']?['templateRow']?['MGA status']}",
                          "item/Agreement Date": "@{body('Parse_report')?['report']?['templateRow']?['Agreement Date']}",
                          "item/Make good measure type": "@{body('Parse_report')?['report']?['templateRow']?['Make good measure type']}",
                          "item/Decommission status": "@{body('Parse_report')?['report']?['templateRow']?['Decommission status']}",
                          "item/Decommission date": "@{body('Parse_report')?['report']?['templateRow']?['Decommission date']}",
                          "item/Comments": "@{body('Parse_report')?['report']?['templateRow']?['Comments']}",
                          "item/Bore name": "@{body('Parse_report')?['report']?['templateRow']?['Bore name']}",
                          "item/Reporting period": "@{body('Parse_report')?['report']?['templateRow']?['Reporting period']}",
                          "item/Submission ID": "@{outputs('Submission_ID')}",
                          "item/Submitted at": "@{outputs('Received_at')}",
                          "item/Submitted by": "@{body('Parse_report')?['submitter']?['email']}",
                          "item/Submitter name": "@{body('Parse_report')?['submitter']?['name']}",
                          "item/Replaces submission": "@{body('Parse_report')?['report']?['replacesSubmissionId']}",
                          "item/Source": "Bore Search Tool",
                          "item/App version": "@{body('Parse_report')?['app']?['version']}",
                          "item/ClientRef": "@{outputs('Client_ref')}"
                        },
                        "retryPolicy": {
                          "type": "fixed",
                          "count": 2,
                          "interval": "PT10S"
                        }
                      },
                      "runAfter": {
                        "Received_at": [
                          "Succeeded"
                        ]
                      },
                      "description": "Excel Online (Business): Add a row into a table. Table MGAData. Tenure Holder comes from the verified TenureHolders row, never from the page. Retry policy Fixed, 2 retries, 10 s so the run ends inside the page's 45 s wait."
                    },
                    "Respond_submitted": {
                      "type": "Response",
                      "kind": "Http",
                      "inputs": {
                        "statusCode": 200,
                        "headers": {
                          "Content-Type": "application/json"
                        },
                        "body": {
                          "ok": true,
                          "submissionId": "@outputs('Submission_ID')",
                          "receivedAt": "@outputs('Received_at')",
                          "receiptTo": "@body('Parse_report')?['submitter']?['email']"
                        }
                      },
                      "runAfter": {
                        "Add_row_to_register": [
                          "Succeeded"
                        ]
                      }
                    },
                    "Respond_failed": {
                      "type": "Response",
                      "kind": "Http",
                      "inputs": {
                        "statusCode": 500,
                        "headers": {
                          "Content-Type": "application/json"
                        },
                        "body": {
                          "ok": false,
                          "error": "OGIA's register could not be updated and nothing was filed. Try again in a few minutes or send the report by email."
                        }
                      },
                      "runAfter": {
                        "Add_row_to_register": [
                          "Failed",
                          "TimedOut"
                        ]
                      }
                    },
                    "Receipt_fields": {
                      "runAfter": {
                        "Respond_submitted": [
                          "Succeeded",
                          "Failed",
                          "TimedOut"
                        ]
                      },
                      "type": "Compose",
                      "description": "Every value that came from the page, HTML-escaped before it goes into an email sent from OGIA's mailbox. The receipt body and subject read only these.",
                      "inputs": {
                        "comments": "@{replace(replace(replace(string(coalesce(body('Parse_report')?['report']?['templateRow']?['Comments'], '')), '&', '&amp;'), '<', '&lt;'), '>', '&gt;')}",
                        "boreName": "@{replace(replace(replace(string(coalesce(body('Parse_report')?['report']?['templateRow']?['Bore name'], '')), '&', '&amp;'), '<', '&lt;'), '>', '&gt;')}",
                        "measures": "@{replace(replace(replace(string(coalesce(body('Parse_report')?['report']?['templateRow']?['Make good measure type'], '')), '&', '&amp;'), '<', '&lt;'), '>', '&gt;')}",
                        "name": "@{replace(replace(replace(string(coalesce(body('Parse_report')?['submitter']?['name'], '')), '&', '&amp;'), '<', '&lt;'), '>', '&gt;')}",
                        "email": "@{replace(replace(replace(string(coalesce(body('Parse_report')?['submitter']?['email'], '')), '&', '&amp;'), '<', '&lt;'), '>', '&gt;')}",
                        "holder": "@{replace(replace(replace(string(coalesce(outputs('Holder_row')?['HolderName'], '')), '&', '&amp;'), '<', '&lt;'), '>', '&gt;')}",
                        "period": "@{replace(replace(replace(string(coalesce(body('Parse_report')?['report']?['templateRow']?['Reporting period'], '')), '&', '&amp;'), '<', '&lt;'), '>', '&gt;')}",
                        "rn": "@{replace(replace(replace(string(coalesce(body('Parse_report')?['report']?['templateRow']?['RN'], '')), '&', '&amp;'), '<', '&lt;'), '>', '&gt;')}",
                        "assessStatus": "@{replace(replace(replace(string(coalesce(body('Parse_report')?['report']?['templateRow']?['Bore assessment status'], '')), '&', '&amp;'), '<', '&lt;'), '>', '&gt;')}",
                        "assessDate": "@{replace(replace(replace(string(coalesce(body('Parse_report')?['report']?['templateRow']?['Bore assessment date'], '')), '&', '&amp;'), '<', '&lt;'), '>', '&gt;')}",
                        "submittedDate": "@{replace(replace(replace(string(coalesce(body('Parse_report')?['report']?['templateRow']?['Submitted to OGIA date'], '')), '&', '&amp;'), '<', '&lt;'), '>', '&gt;')}",
                        "outcome": "@{replace(replace(replace(string(coalesce(body('Parse_report')?['report']?['templateRow']?['Bore assessment outcome'], '')), '&', '&amp;'), '<', '&lt;'), '>', '&gt;')}",
                        "mgaStatus": "@{replace(replace(replace(string(coalesce(body('Parse_report')?['report']?['templateRow']?['MGA status'], '')), '&', '&amp;'), '<', '&lt;'), '>', '&gt;')}",
                        "agreementDate": "@{replace(replace(replace(string(coalesce(body('Parse_report')?['report']?['templateRow']?['Agreement Date'], '')), '&', '&amp;'), '<', '&lt;'), '>', '&gt;')}",
                        "decomStatus": "@{replace(replace(replace(string(coalesce(body('Parse_report')?['report']?['templateRow']?['Decommission status'], '')), '&', '&amp;'), '<', '&lt;'), '>', '&gt;')}",
                        "decomDate": "@{replace(replace(replace(string(coalesce(body('Parse_report')?['report']?['templateRow']?['Decommission date'], '')), '&', '&amp;'), '<', '&lt;'), '>', '&gt;')}",
                        "replaces": "@{replace(replace(replace(string(coalesce(body('Parse_report')?['report']?['replacesSubmissionId'], '')), '&', '&amp;'), '<', '&lt;'), '>', '&gt;')}",
                        "appUrl": "@{replace(replace(replace(string(coalesce(body('Parse_report')?['app']?['url'], '')), '&', '&amp;'), '<', '&lt;'), '>', '&gt;')}",
                        "appVersion": "@{replace(replace(replace(string(coalesce(body('Parse_report')?['app']?['version'], '')), '&', '&amp;'), '<', '&lt;'), '>', '&gt;')}"
                      }
                    },
                    "Email_receipt": {
                      "type": "OpenApiConnection",
                      "inputs": {
                        "host": {
                          "connectionName": "shared_office365",
                          "apiId": "/providers/Microsoft.PowerApps/apis/shared_office365",
                          "operationId": "SendEmailV2"
                        },
                        "parameters": {
                          "emailMessage/To": "@{body('Parse_report')?['submitter']?['email']}",
                          "emailMessage/Cc": "Jeremy.Wolff@dlgwv.qld.gov.au",
                          "emailMessage/Subject": "@{concat('MGA annual report received (PILOT): ', outputs('Submission_ID'), ' (', outputs('Holder_row')?['HolderName'], ', RN ', outputs('Receipt_fields')?['rn'], ', period ', outputs('Receipt_fields')?['period'], ')')}",
                          "emailMessage/Body": "<p>OGIA has received the annual make good agreement report below, lodged through the Bore Search Tool. This email acknowledges receipt of the report for the bore and reporting period shown; keep it with your records.</p><table cellpadding=\"4\" style=\"border-collapse:collapse;font-family:Segoe UI,Arial,sans-serif;font-size:14px\"><tr><td style=\"color:#555\"><b>Receipt</b></td><td>@{outputs('Submission_ID')}</td></tr><tr><td style=\"color:#555\"><b>Received</b></td><td>@{outputs('Received_at')} (Brisbane time)</td></tr><tr><td style=\"color:#555\"><b>Tenure holder</b></td><td>@{outputs('Receipt_fields')?['holder']}</td></tr><tr><td style=\"color:#555\"><b>Reporting period</b></td><td>@{outputs('Receipt_fields')?['period']}</td></tr><tr><td style=\"color:#555\"><b>Bore</b></td><td>RN @{outputs('Receipt_fields')?['rn']} @{outputs('Receipt_fields')?['boreName']}</td></tr><tr><td style=\"color:#555\"><b>Bore assessment status</b></td><td>@{outputs('Receipt_fields')?['assessStatus']}</td></tr><tr><td style=\"color:#555\"><b>Bore assessment date</b></td><td>@{outputs('Receipt_fields')?['assessDate']}</td></tr><tr><td style=\"color:#555\"><b>Notice of Outcome submitted to OGIA</b></td><td>@{outputs('Receipt_fields')?['submittedDate']}</td></tr><tr><td style=\"color:#555\"><b>Bore assessment outcome</b></td><td>@{outputs('Receipt_fields')?['outcome']}</td></tr><tr><td style=\"color:#555\"><b>MGA status</b></td><td>@{outputs('Receipt_fields')?['mgaStatus']}</td></tr><tr><td style=\"color:#555\"><b>Agreement date</b></td><td>@{outputs('Receipt_fields')?['agreementDate']}</td></tr><tr><td style=\"color:#555\"><b>Make good measures</b></td><td>@{outputs('Receipt_fields')?['measures']}</td></tr><tr><td style=\"color:#555\"><b>Decommission status</b></td><td>@{outputs('Receipt_fields')?['decomStatus']}</td></tr><tr><td style=\"color:#555\"><b>Decommission date</b></td><td>@{outputs('Receipt_fields')?['decomDate']}</td></tr><tr><td style=\"color:#555\"><b>Replaces submission</b></td><td>@{outputs('Receipt_fields')?['replaces']}</td></tr><tr><td style=\"color:#555\"><b>Lodged by</b></td><td>@{outputs('Receipt_fields')?['name']} (@{outputs('Receipt_fields')?['email']})</td></tr><tr><td style=\"color:#555\"><b>Lodged from</b></td><td>@{outputs('Receipt_fields')?['appUrl']} (version @{outputs('Receipt_fields')?['appVersion']})</td></tr></table><p><b>Comments</b><br>@{outputs('Receipt_fields')?['comments']}</p><p>If anything above is wrong, open the report in the Bore Search Tool, choose Amend and submit it again; OGIA keeps the latest submission for each bore and period. Pilot: this receipt was sent from the pilot owner's mailbox; in production it comes from OGIA.UWIR@dlgwv.qld.gov.au.</p>",
                          "emailMessage/Importance": "Normal"
                        }
                      },
                      "runAfter": {
                        "Receipt_fields": [
                          "Succeeded"
                        ]
                      },
                      "description": "Office 365 Outlook: Send an email (V2), from the flow owner's own mailbox (pilot). Runs after the page has already been answered, so a mail problem never turns a filed report into an error."
                    },
                    "Receipt_failed_notice": {
                      "type": "OpenApiConnection",
                      "inputs": {
                        "host": {
                          "connectionName": "shared_office365",
                          "apiId": "/providers/Microsoft.PowerApps/apis/shared_office365",
                          "operationId": "SendEmailV2"
                        },
                        "parameters": {
                          "emailMessage/To": "Jeremy.Wolff@dlgwv.qld.gov.au",
                          "emailMessage/Subject": "@{concat('MGA receipt email failed: ', outputs('Submission_ID'))}",
                          "emailMessage/Body": "<p>The report @{outputs('Submission_ID')} was filed in the MGA register but the receipt email to @{outputs('Receipt_fields')?['email']} could not be sent (see the flow run history). Please forward the acknowledgement by hand.</p>",
                          "emailMessage/Importance": "High"
                        }
                      },
                      "runAfter": {
                        "Email_receipt": [
                          "Failed",
                          "TimedOut"
                        ]
                      },
                      "description": "Office 365 Outlook: Send an email (V2) from the flow owner's own mailbox, so it still works when the shared-mailbox permission is the problem."
                    }
                  }
                }
              }
            }
          }
        }
      },
      "else": {
        "actions": {
          "Respond_denied": {
            "type": "Response",
            "kind": "Http",
            "inputs": {
              "statusCode": 403,
              "headers": {
                "Content-Type": "application/json"
              },
              "body": {
                "ok": false,
                "error": "@{if(greater(length(body('Lookup_tenure_holder')?['value']), 0), if(and(equals(toUpper(string(coalesce(outputs('Holder_row')?['AccessCode'], '#none'))), toUpper(string(coalesce(body('Parse_report')?['accessCode'], '')))), equals(toLower(string(coalesce(outputs('Holder_row')?['Active'], ''))), 'yes')), concat('Use a ', outputs('Holder_row')?['EmailDomain'], ' email address for ', outputs('Holder_row')?['HolderName'], '.'), 'Access code not recognised for this tenure holder.'), 'Access code not recognised for this tenure holder.')}"
              }
            }
          }
        }
      }
    }
  },
  "outputs": {}
}
